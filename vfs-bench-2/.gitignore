# Python
.venv/
__pycache__/

# Node
node_modules/
# A symlink, which `node_modules/` (directories only) does not match.
fakes/node_modules
.pnpm-store/
.npm/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

.env
# Downloaded datasets, generated task text and fixtures, per-run fake state.
state/
# Run transcripts, kept local.
dumps/
fakes/*/generated/
# The kit fakes' Prisma clients, generated on first start (harbor/fakes.ts):
# one per schema, the link to the current one, a launcher's staging, and the
# link to Mirage's integ packages Prisma resolves them through. `generated*`
# is what earlier revisions of this layout left, now unused.
mocks/*/client
mocks/*/client-*/
mocks/*/client.*
mocks/*/generated*
mocks/node_modules
