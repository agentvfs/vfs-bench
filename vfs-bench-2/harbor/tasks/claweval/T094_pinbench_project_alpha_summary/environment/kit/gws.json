  {
   "id": "pb18_001",
   "threadId": "pb18_001",
   "internalDate": 1768485600000,
   "bodyText": "Project Alpha is a new customer-facing analytics dashboard replacing the legacy reporting system. Timeline: Beta Launch Apr 21, GA May 12. Tech choices: PostgreSQL plus TimescaleDB, FastAPI, React with Recharts, OAuth2. Original budget is $340K.",
   "headers": [
    {
     "name": "From",
     "value": "sarah.chen@mycompany.com"
    },
    {
     "name": "To",
     "value": "engineering-team@mycompany.com"
    },
    {
     "name": "Subject",
     "value": "Project Alpha - Kickoff and Timeline"
    },
    {
     "name": "Date",
     "value": "Thu, 15 Jan 2026 14:00:00 +0000"
    }
   ],
   "labels": [
    {
     "labelId": "INBOX"
    },
    {
     "labelId": "Label_1"
    },
    {
     "labelId": "UNREAD"
    }
   ]
  },
  {
   "id": "pb18_002",
   "threadId": "pb18_002",
   "internalDate": 1770131700000,
   "bodyText": "The extra infrastructure cost could push Project Alpha from $340K to $432K, a 27 percent overrun. I need cost-benefit analysis and sales confirmation before approving the expanded budget.",
   "headers": [
    {
     "name": "From",
     "value": "linda.zhao@mycompany.com"
    },
    {
     "name": "To",
     "value": "sarah.chen@mycompany.com"
    },
    {
     "name": "Subject",
     "value": "Re: Project Alpha - Budget Overrun Risk"
    },
    {
     "name": "Date",
     "value": "Tue, 03 Feb 2026 15:15:00 +0000"
    }
   ],
   "labels": [
    {
     "labelId": "INBOX"
    },
    {
     "labelId": "Label_1"
    },
    {
     "labelId": "UNREAD"
    }
   ]
  },
  {
   "id": "pb18_003",
   "threadId": "pb18_003",
   "internalDate": 1770739200000,
   "bodyText": "Critical issues: cross-tenant data exposure on the timeseries endpoint and per-message WebSocket authentication. High issues: stronger rate limiting, SSRF hardening on report generation, and missing audit logging.",
   "headers": [
    {
     "name": "From",
     "value": "security@mycompany.com"
    },
    {
     "name": "To",
     "value": "sarah.chen@mycompany.com"
    },
    {
     "name": "Subject",
     "value": "Project Alpha - Mandatory Security Review Findings"
    },
    {
     "name": "Date",
     "value": "Tue, 10 Feb 2026 16:00:00 +0000"
    }
   ],
   "labels": [
    {
     "labelId": "INBOX"
    },
    {
     "labelId": "Label_1"
