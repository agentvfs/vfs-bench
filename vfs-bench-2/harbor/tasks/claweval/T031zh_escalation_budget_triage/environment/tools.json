       "type": "string",
       "description": "按状态筛选 (active/churned)"
      },
      "tier": {
       "type": "string",
       "description": "按等级筛选 (vip/standard)"
      },
      "industry": {
       "type": "string",
       "description": "按行业筛选"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9110/crm/customers",
     "method": "POST"
    }
   },
   {
    "name": "get_customer",
    "call": "crm_get_customer",
    "description": "获取客户详细信息",
    "parameters": {
     "type": "object",
     "properties": {
      "customer_id": {
       "type": "string",
       "description": "客户ID"
      }
     },
     "required": [
      "customer_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9110/crm/customers/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "finance",
  "description": "The finance service's tools.",
  "tools": [
   {
    "name": "list_transactions",
    "call": "finance_list_transactions",
    "description": "获取财务交易记录列表",
    "parameters": {
     "type": "object",
     "properties": {
      "start_date": {
       "type": "string",
       "description": "开始日期 (YYYY-MM-DD)"
      },
      "end_date": {
       "type": "string",
       "description": "结束日期 (YYYY-MM-DD)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9104/finance/transactions",
     "method": "POST"
    }
   },
   {
    "name": "get_transaction",
    "call": "finance_get_transaction",
    "description": "获取财务交易详情",
    "parameters": {
     "type": "object",
     "properties": {
      "transaction_id": {
       "type": "string",
       "description": "交易ID"
      }
     },
     "required": [
      "transaction_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9104/finance/transactions/get",
     "method": "POST"
    }
   }
  ]
 }
]
