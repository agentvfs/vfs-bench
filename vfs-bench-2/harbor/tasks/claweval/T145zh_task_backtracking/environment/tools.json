[
 {
  "name": "gmail",
  "description": "The gmail service's tools.",
  "tools": [
   {
    "name": "save_draft",
    "call": "gmail_save_draft",
    "description": "保存邮件草稿",
    "parameters": {
     "type": "object",
     "properties": {
      "to": {
       "type": "string",
       "description": "收件人"
      },
      "subject": {
       "type": "string",
       "description": "主题"
      },
      "body": {
       "type": "string",
       "description": "正文"
      },
      "reply_to_message_id": {
       "type": "string",
       "description": "回复的原邮件ID"
      }
     },
     "required": [
      "to",
      "subject",
      "body"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9100/gmail/drafts/save",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "todo",
  "description": "The todo service's tools.",
  "tools": [
   {
    "name": "list_tasks",
    "call": "todo_list_tasks",
    "description": "列出待办事项",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "状态筛选(all/pending/in_progress/completed)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9102/todo/tasks",
     "method": "POST"
    }
   },
   {
    "name": "get_task",
    "call": "todo_get_task",
    "description": "获取待办详情",
    "parameters": {
     "type": "object",
     "properties": {
      "task_id": {
       "type": "string",
       "description": "待办ID"
      }
     },
     "required": [
      "task_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9102/todo/tasks/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "notes",
  "description": "The notes service's tools.",
  "tools": [
   {
    "name": "list",
    "call": "notes_list",
    "description": "列出会议纪要",
    "parameters": {
     "type": "object",
     "properties": {
      "days_back": {
       "type": "integer",
       "description": "最近几天",
       "default": 30
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9105/notes/list",
     "method": "POST"
    }
   },
   {
    "name": "get",
    "call": "notes_get",
    "description": "获取会议纪要详情",
    "parameters": {
     "type": "object",
     "properties": {
      "note_id": {
       "type": "string",
       "description": "纪要ID"
      }
     },
     "required": [
      "note_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9105/notes/get",
     "method": "POST"
    }
   }
  ]
 }
]
