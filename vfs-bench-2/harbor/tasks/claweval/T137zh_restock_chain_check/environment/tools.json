    }
   }
  ]
 },
 {
  "name": "inventory",
  "description": "The inventory service's tools.",
  "tools": [
   {
    "name": "list_items",
    "call": "inventory_list_items",
    "description": "查看库存列表",
    "parameters": {
     "type": "object",
     "properties": {
      "category": {
       "type": "string",
       "description": "按分类筛选"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9108/inventory/products",
     "method": "POST"
    }
   },
   {
    "name": "get_item",
    "call": "inventory_get_item",
    "description": "获取库存品详情",
    "parameters": {
     "type": "object",
     "properties": {
      "product_id": {
       "type": "string",
       "description": "产品ID"
      }
     },
     "required": [
      "product_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9108/inventory/products/get",
     "method": "POST"
    }
   }
  ]
 }
]
