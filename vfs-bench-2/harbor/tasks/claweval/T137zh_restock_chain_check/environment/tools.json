[
 {
  "name": "scheduler",
  "description": "The scheduler service's tools.",
  "tools": [
   {
    "name": "list_jobs",
    "call": "scheduler_list_jobs",
    "description": "列出定时任务",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "按状态筛选(all/enabled/disabled)"
      },
      "tag": {
       "type": "string",
       "description": "按标签筛选"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs",
     "method": "POST"
    }
   },
   {
    "name": "get_job",
    "call": "scheduler_get_job",
    "description": "获取定时任务详情",
    "parameters": {
     "type": "object",
     "properties": {
      "job_id": {
       "type": "string",
       "description": "任务ID"
      }
     },
     "required": [
      "job_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "config",
