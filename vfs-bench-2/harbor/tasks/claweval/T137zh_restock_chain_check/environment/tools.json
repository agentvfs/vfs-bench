    "parameters": {
     "type": "object",
     "properties": {
      "integration_id": {
       "type": "string",
       "description": "集成ID"
      }
     },
     "required": [
      "integration_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9111/config/integrations/get",
