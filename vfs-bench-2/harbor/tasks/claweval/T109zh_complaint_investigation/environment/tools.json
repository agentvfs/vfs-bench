[
 {
  "name": "gmail",
  "description": "The gmail service's tools.",
  "tools": [
   {
    "name": "save_draft",
    "call": "gmail_save_draft",
    "description": "保存邮件草稿",
    "parameters": {
     "type": "object",
     "properties": {
      "to": {
       "type": "string",
       "description": "收件人"
      },
      "subject": {
       "type": "string",
       "description": "主题"
      },
      "body": {
       "type": "string",
       "description": "正文"
      },
      "reply_to_message_id": {
       "type": "string",
       "description": "回复的原邮件ID"
      }
     },
     "required": [
      "to",
      "subject",
      "body"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9100/gmail/drafts/save",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "contacts",
  "description": "The contacts service's tools.",
  "tools": [
   {
    "name": "search",
    "call": "contacts_search",
    "description": "搜索内部通讯录",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "搜索关键词"
      },
      "department": {
       "type": "string",
       "description": "按部门筛选"
      }
     },
     "required": [
      "query"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9103/contacts/search",
     "method": "POST"
    }
   },
   {
    "name": "get",
    "call": "contacts_get",
    "description": "获取联系人详情",
    "parameters": {
     "type": "object",
     "properties": {
      "contact_id": {
       "type": "string",
       "description": "联系人ID"
      }
     },
     "required": [
      "contact_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9103/contacts/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "crm",
  "description": "The crm service's tools.",
  "tools": [
   {
    "name": "list_customers",
    "call": "crm_list_customers",
    "description": "列出客户",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "客户状态筛选"
      },
      "tier": {
       "type": "string",
       "description": "客户等级筛选(vip/standard)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9110/crm/customers",
     "method": "POST"
    }
   },
   {
    "name": "get_customer",
    "call": "crm_get_customer",
    "description": "获取客户详情",
    "parameters": {
     "type": "object",
     "properties": {
      "customer_id": {
       "type": "string",
       "description": "客户ID"
      }
     },
     "required": [
      "customer_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9110/crm/customers/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "finance",
  "description": "The finance service's tools.",
  "tools": [
   {
    "name": "list_transactions",
    "call": "finance_list_transactions",
    "description": "查看交易记录",
    "parameters": {
     "type": "object",
     "properties": {
      "start_date": {
       "type": "string",
       "description": "起始日期(YYYY-MM-DD)"
      },
      "end_date": {
       "type": "string",
       "description": "截止日期(YYYY-MM-DD)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9104/finance/transactions",
     "method": "POST"
    }
   },
   {
    "name": "get_transaction",
    "call": "finance_get_transaction",
    "description": "获取交易详情",
    "parameters": {
     "type": "object",
     "properties": {
      "transaction_id": {
       "type": "string",
       "description": "交易ID"
      }
     },
     "required": [
      "transaction_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9104/finance/transactions/get",
     "method": "POST"
    }
   }
  ]
 }
]
