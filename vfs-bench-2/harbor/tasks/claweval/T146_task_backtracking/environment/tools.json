[
 {
  "name": "gmail",
  "description": "The gmail service's tools.",
  "tools": [
   {
    "name": "save_draft",
    "call": "gmail_save_draft",
    "description": "Save an email draft",
    "parameters": {
     "type": "object",
     "properties": {
      "to": {
       "type": "string",
       "description": "Recipient"
      },
      "subject": {
       "type": "string",
       "description": "Subject"
      },
      "body": {
       "type": "string",
       "description": "Body"
      },
      "reply_to_message_id": {
       "type": "string",
       "description": "Original message ID being replied to"
      }
     },
     "required": [
      "to",
      "subject",
      "body"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9100/gmail/drafts/save",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "todo",
  "description": "The todo service's tools.",
  "tools": [
   {
    "name": "list_tasks",
    "call": "todo_list_tasks",
    "description": "List to-do items",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "Status filter (all/pending/in_progress/completed)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9102/todo/tasks",
     "method": "POST"
    }
   },
   {
    "name": "get_task",
    "call": "todo_get_task",
    "description": "Get to-do item details",
    "parameters": {
     "type": "object",
     "properties": {
      "task_id": {
       "type": "string",
       "description": "Task ID"
      }
     },
     "required": [
      "task_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9102/todo/tasks/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "notes",
  "description": "The notes service's tools.",
  "tools": [
   {
    "name": "list",
    "call": "notes_list",
    "description": "List meeting notes",
    "parameters": {
     "type": "object",
     "properties": {
      "days_back": {
       "type": "integer",
       "description": "Last N days",
       "default": 30
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9105/notes/list",
     "method": "POST"
    }
   },
   {
    "name": "get",
    "call": "notes_get",
    "description": "Get meeting note details",
    "parameters": {
     "type": "object",
     "properties": {
      "note_id": {
       "type": "string",
       "description": "Note ID"
      }
     },
     "required": [
      "note_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9105/notes/get",
     "method": "POST"
    }
   }
  ]
 }
]
