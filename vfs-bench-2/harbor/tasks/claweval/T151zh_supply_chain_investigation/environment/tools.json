     "type": "object",
     "properties": {
      "category": {
       "type": "string",
       "description": "按分类筛选"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9108/inventory/products",
     "method": "POST"
    }
   },
   {
    "name": "get_item",
    "call": "inventory_get_item",
    "description": "获取库存品详情",
    "parameters": {
