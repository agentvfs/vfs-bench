     "properties": {
      "product_id": {
       "type": "string",
       "description": "产品ID"
      }
     },
     "required": [
      "product_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9108/inventory/products/get",
     "method": "POST"
    }
   }
  ]
 },
 {
