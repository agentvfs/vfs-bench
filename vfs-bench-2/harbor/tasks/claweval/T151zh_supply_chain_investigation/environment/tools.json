[
 {
  "name": "helpdesk",
  "description": "The helpdesk service's tools.",
  "tools": [
   {
    "name": "list_tickets",
    "call": "helpdesk_list_tickets",
    "description": "列出工单",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "工单状态筛选(open/all)",
       "default": "open"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets",
     "method": "POST"
    }
   },
   {
    "name": "get_ticket",
    "call": "helpdesk_get_ticket",
    "description": "获取工单详情",
    "parameters": {
     "type": "object",
     "properties": {
      "ticket_id": {
       "type": "string",
       "description": "工单ID"
      }
     },
     "required": [
      "ticket_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets/get",
     "method": "POST"
    }
   },
   {
    "name": "update_ticket",
    "call": "helpdesk_update_ticket",
    "description": "更新工单（优先级、标签、分类）",
    "parameters": {
     "type": "object",
     "properties": {
      "ticket_id": {
       "type": "string",
       "description": "工单ID"
      },
      "priority": {
       "type": "string",
       "description": "优先级"
      },
      "tags": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "标签列表"
      },
      "category": {
       "type": "string",
       "description": "工单分类"
      }
     },
     "required": [
      "ticket_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets/update",
     "method": "POST"
    }
   },
   {
    "name": "close_ticket",
    "call": "helpdesk_close_ticket",
    "description": "关闭工单",
    "parameters": {
     "type": "object",
     "properties": {
      "ticket_id": {
       "type": "string",
       "description": "工单ID"
      },
      "resolution": {
       "type": "string",
       "description": "解决说明"
      }
     },
     "required": [
      "ticket_id",
      "resolution"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets/close",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "inventory",
