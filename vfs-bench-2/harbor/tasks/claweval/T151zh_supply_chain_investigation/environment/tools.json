 },
 {
  "name": "crm",
  "description": "The crm service's tools.",
  "tools": [
   {
    "name": "list_customers",
    "call": "crm_list_customers",
    "description": "列出客户和供应商",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "状态筛选(active/suspended)"
      },
      "tier": {
       "type": "string",
       "description": "等级筛选(vip/standard/core)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9110/crm/customers",
     "method": "POST"
    }
   },
   {
    "name": "get_customer",
    "call": "crm_get_customer",
