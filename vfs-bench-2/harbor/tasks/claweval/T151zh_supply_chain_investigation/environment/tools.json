    "parameters": {
     "type": "object",
     "properties": {
      "customer_id": {
       "type": "string",
       "description": "客户/供应商ID"
      }
     },
     "required": [
      "customer_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9110/crm/customers/get",
     "method": "POST"
    }
   }
  ]
 }
]
