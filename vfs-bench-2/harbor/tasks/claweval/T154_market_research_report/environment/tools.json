[
 {
  "name": "rss",
  "description": "The rss service's tools.",
  "tools": [
   {
    "name": "list_articles",
    "call": "rss_list_articles",
    "description": "List RSS articles",
    "parameters": {
     "type": "object",
     "properties": {
      "feed_name": {
       "type": "string",
       "description": "Filter by RSS feed name"
      },
      "category": {
       "type": "string",
       "description": "Filter by category"
      },
      "max_results": {
       "type": "integer",
       "description": "Maximum number of results",
       "default": 20
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9109/rss/articles",
     "method": "POST"
    }
   },
   {
    "name": "get_article",
    "call": "rss_get_article",
    "description": "Get article details",
    "parameters": {
     "type": "object",
     "properties": {
      "article_id": {
       "type": "string",
       "description": "Article ID"
      }
     },
     "required": [
      "article_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9109/rss/articles/get",
     "method": "POST"
    }
   }
  ]
 },
