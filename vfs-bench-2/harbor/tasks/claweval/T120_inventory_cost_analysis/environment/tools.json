[
 {
  "name": "inventory",
  "description": "The inventory service's tools.",
  "tools": [
   {
    "name": "list_items",
    "call": "inventory_list_items",
    "description": "View inventory list",
    "parameters": {
     "type": "object",
     "properties": {
      "category": {
       "type": "string",
       "description": "Filter by category"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9108/inventory/products",
     "method": "POST"
    }
   },
   {
    "name": "get_item",
    "call": "inventory_get_item",
    "description": "Get inventory item details",
    "parameters": {
     "type": "object",
     "properties": {
      "product_id": {
       "type": "string",
       "description": "Product ID"
      }
     },
     "required": [
      "product_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9108/inventory/products/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "finance",
  "description": "The finance service's tools.",
  "tools": [
   {
    "name": "list_transactions",
    "call": "finance_list_transactions",
    "description": "View transaction records",
    "parameters": {
     "type": "object",
     "properties": {
      "start_date": {
       "type": "string",
       "description": "Start date (YYYY-MM-DD)"
      },
      "end_date": {
       "type": "string",
       "description": "End date (YYYY-MM-DD)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9104/finance/transactions",
     "method": "POST"
    }
   },
   {
    "name": "get_transaction",
