 {
  "name": "kb",
  "description": "The kb service's tools.",
  "tools": [
   {
    "name": "search",
    "call": "kb_search",
    "description": "Search knowledge base articles",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "Search keywords"
      },
      "category": {
       "type": "string",
       "description": "Filter by category"
      },
      "max_results": {
       "type": "integer",
       "description": "Maximum number of results to return",
       "default": 5
      }
     },
     "required": [
      "query"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/search",
     "method": "POST"
    }
   },
   {
    "name": "get_article",
