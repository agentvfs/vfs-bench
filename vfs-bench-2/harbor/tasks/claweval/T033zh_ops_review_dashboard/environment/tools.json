     },
     "required": [
      "job_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs/get",
     "method": "POST"
    }
   },
   {
    "name": "job_history",
    "call": "scheduler_job_history",
    "description": "查看定时任务执行历史",
    "parameters": {
     "type": "object",
     "properties": {
      "job_id": {
       "type": "string",
       "description": "任务ID"
      },
      "limit": {
       "type": "integer",
       "description": "返回条数",
       "default": 10
      }
     },
     "required": [
      "job_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs/history",
     "method": "POST"
    }
   }
  ]
 }
