[
 {
  "name": "config",
  "description": "The config service's tools.",
  "tools": [
   {
    "name": "list_integrations",
    "call": "config_list_integrations",
    "description": "获取所有第三方集成的列表（概览信息）",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "按状态筛选：active, degraded, expired"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9111/config/integrations",
     "method": "POST"
    }
   },
   {
    "name": "get_integration",
    "call": "config_get_integration",
    "description": "获取单个集成的完整配置信息",
    "parameters": {
     "type": "object",
     "properties": {
      "integration_id": {
       "type": "string",
       "description": "集成ID"
      }
     },
     "required": [
      "integration_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9111/config/integrations/get",
     "method": "POST"
    }
   }
  ]
 },
