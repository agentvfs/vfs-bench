[
 {
  "name": "rss",
  "description": "The rss service's tools.",
  "tools": [
   {
    "name": "list_articles",
    "call": "rss_list_articles",
    "description": "Get RSS article list",
    "parameters": {
     "type": "object",
     "properties": {
      "feed_name": {
       "type": "string",
       "description": "Filter by RSS feed"
      },
      "category": {
       "type": "string",
       "description": "Filter by category"
      },
      "max_results": {
       "type": "integer",
       "description": "Maximum number of results",
       "default": 20
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9109/rss/articles",
     "method": "POST"
    }
   },
   {
    "name": "get_article",
    "call": "rss_get_article",
    "description": "Get article details",
    "parameters": {
     "type": "object",
     "properties": {
      "article_id": {
       "type": "string",
       "description": "Article ID"
      }
     },
     "required": [
      "article_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9109/rss/articles/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "kb",
  "description": "The kb service's tools.",
  "tools": [
   {
    "name": "search",
    "call": "kb_search",
    "description": "Search knowledge base articles",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "Search keyword"
      },
      "category": {
       "type": "string",
       "description": "Filter by category"
      },
      "max_results": {
       "type": "integer",
       "description": "Maximum number of results",
       "default": 5
      }
     },
     "required": [
      "query"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/search",
     "method": "POST"
    }
   },
   {
    "name": "get_article",
    "call": "kb_get_article",
    "description": "Get full knowledge base article",
    "parameters": {
     "type": "object",
     "properties": {
      "article_id": {
       "type": "string",
       "description": "Article ID"
      }
     },
     "required": [
      "article_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/articles/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "gmail",
  "description": "The gmail service's tools.",
  "tools": [
   {
    "name": "save_draft",
    "call": "gmail_save_draft",
    "description": "Save email draft",
    "parameters": {
     "type": "object",
     "properties": {
      "to": {
       "type": "string",
       "description": "Recipient"
      },
      "subject": {
       "type": "string",
       "description": "Subject"
      },
      "body": {
       "type": "string",
       "description": "Body"
      }
     },
     "required": [
      "to",
      "subject",
      "body"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9100/gmail/drafts/save",
     "method": "POST"
    }
   }
  ]
 }
]
