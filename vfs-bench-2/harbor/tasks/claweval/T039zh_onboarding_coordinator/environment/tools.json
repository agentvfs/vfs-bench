[
 {
  "name": "gmail",
  "description": "The gmail service's tools.",
  "tools": [
   {
    "name": "save_draft",
    "call": "gmail_save_draft",
    "description": "将邮件保存为草稿",
    "parameters": {
     "type": "object",
     "properties": {
      "to": {
       "type": "string",
       "description": "收件人邮箱地址"
      },
      "subject": {
       "type": "string",
       "description": "邮件主题"
      },
      "body": {
       "type": "string",
       "description": "邮件正文"
      },
      "reply_to_message_id": {
       "type": "string",
       "description": "如果是回复邮件，原邮件ID"
      }
     },
     "required": [
      "to",
      "subject",
      "body"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9100/gmail/drafts/save",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "todo",
  "description": "The todo service's tools.",
  "tools": [
   {
    "name": "list_tasks",
    "call": "todo_list_tasks",
    "description": "获取待办事项列表",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "按状态筛选 (pending/in_progress/completed)"
      },
      "priority": {
       "type": "string",
       "description": "按优先级筛选 (high/medium/low)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9102/todo/tasks",
     "method": "POST"
    }
   },
   {
    "name": "create_task",
    "call": "todo_create_task",
    "description": "创建新的待办事项",
    "parameters": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string",
       "description": "待办标题"
      },
      "description": {
       "type": "string",
       "description": "详细描述"
      },
      "priority": {
       "type": "string",
       "description": "优先级 (high/medium/low)"
      },
      "due_date": {
       "type": "string",
       "description": "截止日期 (YYYY-MM-DD)"
      },
      "tags": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "标签列表"
      }
     },
     "required": [
      "title"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9102/todo/tasks/create",
     "method": "POST"
    }
   },
   {
    "name": "update_task",
    "call": "todo_update_task",
    "description": "更新待办事项",
    "parameters": {
     "type": "object",
     "properties": {
      "task_id": {
       "type": "string",
       "description": "待办事项ID"
      },
      "status": {
       "type": "string",
       "description": "新状态"
      },
      "priority": {
       "type": "string",
       "description": "新优先级"
      },
      "title": {
       "type": "string",
       "description": "新标题"
      },
      "description": {
       "type": "string",
       "description": "新描述"
      }
     },
     "required": [
      "task_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9102/todo/tasks/update",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "contacts",
  "description": "The contacts service's tools.",
  "tools": [
   {
    "name": "search",
    "call": "contacts_search",
    "description": "搜索通讯录中的联系人",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "搜索关键词（姓名、部门等）"
      },
      "department": {
       "type": "string",
       "description": "按部门筛选"
      }
     },
     "required": [
      "query"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9103/contacts/search",
     "method": "POST"
    }
   },
   {
    "name": "get",
    "call": "contacts_get",
    "description": "获取联系人详细信息",
    "parameters": {
     "type": "object",
     "properties": {
      "contact_id": {
       "type": "string",
       "description": "联系人ID"
      }
     },
     "required": [
      "contact_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9103/contacts/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "kb",
  "description": "The kb service's tools.",
  "tools": [
   {
    "name": "search",
    "call": "kb_search",
    "description": "搜索知识库文章",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "搜索关键词"
      },
      "category": {
       "type": "string",
       "description": "按分类筛选"
      },
      "max_results": {
       "type": "integer",
       "description": "最大返回数量",
       "default": 5
      }
     },
     "required": [
      "query"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/search",
     "method": "POST"
    }
   },
   {
    "name": "get_article",
    "call": "kb_get_article",
    "description": "获取知识库文章详情",
    "parameters": {
     "type": "object",
     "properties": {
      "article_id": {
       "type": "string",
       "description": "文章ID"
      }
     },
     "required": [
      "article_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/articles/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "inventory",
  "description": "The inventory service's tools.",
  "tools": [
   {
    "name": "list_products",
    "call": "inventory_list_products",
    "description": "获取库存产品列表",
    "parameters": {
     "type": "object",
     "properties": {
      "category": {
       "type": "string",
       "description": "按分类筛选"
      },
      "status": {
       "type": "string",
       "description": "按库存状态筛选 (normal/out_of_stock/low_stock)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9108/inventory/products",
     "method": "POST"
    }
   },
   {
    "name": "get_product",
    "call": "inventory_get_product",
    "description": "获取产品库存详情",
    "parameters": {
     "type": "object",
     "properties": {
      "product_id": {
       "type": "string",
       "description": "产品ID"
      }
     },
     "required": [
      "product_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9108/inventory/products/get",
     "method": "POST"
    }
   }
  ]
 }
]
