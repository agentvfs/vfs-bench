[
 {
  "name": "helpdesk",
  "description": "The helpdesk service's tools.",
  "tools": [
   {
    "name": "list_tickets",
    "call": "helpdesk_list_tickets",
    "description": "获取工单列表",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "按状态筛选：open, resolved, done, investigating"
      },
      "priority": {
       "type": "string",
       "description": "按优先级筛选：low, medium, high, critical"
      },
      "date_from": {
       "type": "string",
       "description": "起始日期 (ISO 8601)"
      },
      "date_to": {
       "type": "string",
       "description": "截止日期 (ISO 8601)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets",
     "method": "POST"
    }
   },
   {
    "name": "get_ticket",
    "call": "helpdesk_get_ticket",
    "description": "获取单个工单详情",
    "parameters": {
     "type": "object",
     "properties": {
      "ticket_id": {
       "type": "string",
       "description": "工单ID"
      }
     },
     "required": [
      "ticket_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "config",
