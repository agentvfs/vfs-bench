    "description": "获取笔记/会议记录列表",
    "parameters": {
     "type": "object",
     "properties": {
      "date_from": {
       "type": "string",
       "description": "起始日期"
      },
      "date_to": {
       "type": "string",
       "description": "截止日期"
      },
      "tag": {
       "type": "string",
       "description": "按标签筛选"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9105/notes/list",
     "method": "POST"
    }
   },
   {
    "name": "get",
    "call": "notes_get",
    "description": "获取笔记/会议记录详情",
    "parameters": {
     "type": "object",
     "properties": {
      "note_id": {
       "type": "string",
       "description": "笔记ID"
      }
     },
     "required": [
      "note_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9105/notes/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "scheduler",
  "description": "The scheduler service's tools.",
  "tools": [
   {
    "name": "list_jobs",
    "call": "scheduler_list_jobs",
    "description": "列出所有定时任务",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "按最近运行状态筛选 (success/failed/stopped)"
      },
      "enabled": {
       "type": "boolean",
       "description": "按启用状态筛选"
      },
      "tag": {
       "type": "string",
       "description": "按标签筛选"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs",
     "method": "POST"
    }
   },
   {
    "name": "get_job",
    "call": "scheduler_get_job",
    "description": "获取定时任务详情",
    "parameters": {
     "type": "object",
     "properties": {
      "job_id": {
       "type": "string",
       "description": "任务ID"
      }
     },
     "required": [
      "job_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs/get",
     "method": "POST"
    }
   },
   {
    "name": "job_history",
    "call": "scheduler_job_history",
    "description": "查看定时任务执行历史",
    "parameters": {
     "type": "object",
     "properties": {
      "job_id": {
       "type": "string",
       "description": "任务ID"
      },
      "limit": {
       "type": "integer",
       "description": "返回条数",
       "default": 10
      }
     },
     "required": [
      "job_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs/history",
     "method": "POST"
    }
   }
  ]
 }
]
