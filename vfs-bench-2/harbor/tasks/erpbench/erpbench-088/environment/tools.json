[
 {
  "name": "erpbench",
  "description": "ERPBench's erpbench tools.",
  "tools": [
   {
    "name": "get_task",
    "call": "erpbench.get_task",
    "description": "Read the task-scoped outcome contract without revealing the gold answer.",
    "parameters": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "task_id": {
       "type": "string",
       "description": "Task identifier"
      }
     },
     "required": [
      "task_id"
     ]
    },
    "endpoint": {
     "url": "http://erpbench/erpbench.get_task",
     "method": "POST"
    }
   },
   {
    "name": "get_decision",
    "call": "erpbench.get_decision",
    "description": "Read back the durable decision record for a task.",
    "parameters": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "task_id": {
       "type": "string",
       "description": "Task identifier"
      }
     },
     "required": [
      "task_id"
     ]
    },
    "endpoint": {
     "url": "http://erpbench/erpbench.get_decision",
     "method": "POST"
    }
   },
   {
    "name": "get_submission",
    "call": "erpbench.get_submission",
    "description": "Read back the durable submitted answer.",
    "parameters": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "task_id": {
       "type": "string",
       "description": "Task identifier"
      }
     },
     "required": [
      "task_id"
     ]
    },
    "endpoint": {
     "url": "http://erpbench/erpbench.get_submission",
     "method": "POST"
    }
   },
   {
    "name": "record_decision",
    "call": "erpbench.record_decision",
    "description": "Record the selected option, status, primary ERP record, rationale and source references.",
    "parameters": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "task_id": {
       "type": "string",
       "description": "Active task identifier; every write must carry it"
      },
      "decision": {
       "type": "string",
       "description": "Selected option"
      },
      "status": {
       "type": "string",
       "description": "Decision status"
      },
      "primary_record": {
       "type": "string",
       "description": "Primary ERP record number"
      },
      "rationale": {
       "type": "string",
       "description": "Rationale"
      },
      "source_refs": {
       "type": "array",
       "description": "Source references",
       "items": {
        "type": "string"
       }
      }
     },
     "required": [
      "task_id",
      "decision",
      "status",
      "primary_record",
      "rationale",
      "source_refs"
     ]
    },
    "endpoint": {
     "url": "http://erpbench/erpbench.record_decision",
     "method": "POST"
    }
   },
   {
    "name": "submit_answer",
    "call": "erpbench.submit_answer",
    "description": "Persist the structured final answer for deterministic grading.",
    "parameters": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "task_id": {
       "type": "string",
       "description": "Active task identifier; every write must carry it"
      },
      "answers": {
       "additionalProperties": false,
       "properties": {
        "already_synced": {
         "description": "Rows already carrying a sales order",
         "type": "integer"
        },
        "channel_rows": {
         "description": "Rows in the channel export",
         "type": "integer"
        },
        "created_orders": {
         "description": "Sales orders created",
         "type": "integer"
        },
        "decision_status": {
         "description": "One of the status ids listed in the task contract",
         "enum": [
          "synced",
          "sync_blocked"
         ],
         "type": "string"
        },
        "duplicate_rows": {
         "description": "Repeated rows skipped",
         "type": "integer"
        },
        "primary_record": {
         "description": "The primary ERP record number created or updated (as returned by the system)",
         "type": "string"
        },
        "recommended_option": {
         "description": "One of the decision option ids listed in the task contract",
         "enum": [
          "create_unsynced_orders_and_capture_customer",
          "create_all_export_rows",
          "skip_sync_pending_dedup_review",
          "escalate_without_executing"
         ],
         "type": "string"
        },
        "source_reference": {
         "description": "Drive file id of the operative (current-authority) source document you relied on",
         "type": "string"
        },
        "synced_value": {
         "description": "Value of the sales orders created",
         "multipleOf": 0.01,
         "type": "number"
        }
       },
       "required": [
        "recommended_option",
        "decision_status",
        "source_reference",
        "primary_record",
        "channel_rows",
        "already_synced",
        "created_orders",
        "duplicate_rows",
        "synced_value"
       ],
       "type": "object"
      }
     },
     "required": [
      "task_id",
      "answers"
     ]
    },
    "endpoint": {
     "url": "http://erpbench/erpbench.submit_answer",
     "method": "POST"
    }
   }
  ]
 },
