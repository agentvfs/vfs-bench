// The health fake's store: LiveClawBench's health mock (Mosi-AI/LiveClawBench
// @ 303dc77, MIT, mock-platform/mocks/health), one SQLite file per run.
//
// Generated with `prisma db pull` from upstream's own CREATE TABLE and
// CREATE INDEX statements (each fixture's `_schema`), so each table, column,
// key, foreign key and index is upstream's, by name and in order, and
// upstream's verify.py and its own statements read a run's file as they
// read upstream's. Column types are as SQLite keeps them (text, integer,
// real); a default of SQLite's 'now' is `datetime('now')`, which each run
// answers with its clock. Prisma cannot state upstream's CHECKs: each run
// gets them as triggers (mocks/upstream/checks.ts). The last four models
// are the fake's own (mocks/upstream).
//
// No tenant column: a run is one world, as upstream's mock is one.

datasource db {
  provider = "sqlite"
  url      = env("INTEG_DB_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "client"
}

model migrations {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  applied_at String? @default(dbgenerated("(datetime('now'))"))

  @@map("_migrations")
}

model allergen {
  id          Int       @id @default(autoincrement())
  user_id     Int       @default(1)
  name        String
  severity    String?
  notes       String?
  archived    Int       @default(0)
  archived_at String?
  created_at  String    @default(dbgenerated("(datetime('now'))"))
  updated_at  String    @default(dbgenerated("(datetime('now'))"))
  mock_user   mock_user @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, archived], map: "idx_allergen_user")
}

model health_daily_snapshot {
  id                     Int       @id @default(autoincrement())
  user_id                Int       @default(1)
  date                   String
  steps                  Int?
  active_energy_kcal     Float?
  sleep_hours            Float?
  sleep_quality          Float?
  light_sleep_hours      Float?
  deep_sleep_hours       Float?
  rem_sleep_hours        Float?
  low_intensity_min      Float?
  medium_intensity_min   Float?
  high_intensity_min     Float?
  total_activity_min     Float?
  resting_heart_rate_bpm Int?
  avg_heart_rate_bpm     Int?
  weight_kg              Float?
  body_fat_percent       Float?
  blood_oxygen_percent   Float?
  created_at             String    @default(dbgenerated("(datetime('now'))"))
  mock_user              mock_user @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, date])
  @@index([user_id, date], map: "idx_snapshot_user_date")
}

model health_metric_series {
  id          Int       @id @default(autoincrement())
  user_id     Int       @default(1)
  metric_type String
  date        String
  value       Float
  created_at  String    @default(dbgenerated("(datetime('now'))"))
  mock_user   mock_user @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, metric_type, date])
  @@index([user_id, metric_type, date], map: "idx_metric_user_type_date")
}

model medication {
  id                     Int                      @id @default(autoincrement())
  user_id                Int                      @default(1)
  name                   String
  display_name           String?
  frequency              String                   @default("daily")
  dose_amount            Float?
  dose_unit              String?
  start_date             String
  end_date               String?
  notes                  String?
  archived               Int                      @default(0)
  archived_at            String?
  created_at             String                   @default(dbgenerated("(datetime('now'))"))
  updated_at             String                   @default(dbgenerated("(datetime('now'))"))
  mock_user              mock_user                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medication_dose_log    medication_dose_log[]
  medication_intake_slot medication_intake_slot[]

  @@index([user_id, archived], map: "idx_medication_user")
}

model medication_dose_log {
  id                     Int                     @id @default(autoincrement())
  medication_id          Int
  slot_id                Int?
  logged_at              String                  @default(dbgenerated("(datetime('now'))"))
  status                 String                  @default("taken")
  log_dose_amount        Float?
  log_dose_unit          String?
  notes                  String?
  created_at             String                  @default(dbgenerated("(datetime('now'))"))
  updated_at             String                  @default(dbgenerated("(datetime('now'))"))
  medication_intake_slot medication_intake_slot? @relation(fields: [slot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medication             medication              @relation(fields: [medication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([medication_id, logged_at], map: "idx_dose_log_medication")
}

model medication_intake_slot {
  id                  Int                   @id @default(autoincrement())
  medication_id       Int
  time_hhmm           String
  dose_amount         Float?
  dose_unit           String?
  label               String?
  medication_dose_log medication_dose_log[]
  medication          medication            @relation(fields: [medication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([medication_id], map: "idx_slot_medication")
}

model mock_user {
  id                    Int                     @id @default(autoincrement())
  username              String                  @unique
  display_name          String?
  created_at            String                  @default(dbgenerated("(datetime('now'))"))
  allergen              allergen[]
  health_daily_snapshot health_daily_snapshot[]
  health_metric_series  health_metric_series[]
  medication            medication[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model system_config {
  key   String? @id
  value String

  @@ignore
}

// The environment upstream's mock reads from its process (`TASK_NAME`),
// which a fake every task of a job shares cannot take from its own: each
// task's fixture states it.
model vfsbench_env {
  name  String @id
  value String

  @@map("_env")
}

// Each file the mock keeps on disk upstream, by its path in the image, and
// the task's assets: text as it is, anything else as base64.
model vfsbench_file {
  path     String @id
  data     String
  encoding String @default("utf8")

  @@map("_file")
}

// The rows of upstream's tables Prisma cannot key (marked @@ignore above),
// which the fake inserts itself, in order, once the kit has seeded the rest.
model vfsbench_row {
  seq   Int    @id
  table String
  data  String

  @@map("_row")
}

// Upstream's CREATE TABLE and CREATE INDEX statements, as its seed ran them.
model vfsbench_schema {
  name String @id
  type String
  sql  String

  @@map("_schema")
}
