// The workspace fake's store: LiveClawBench's workspace mock (Mosi-AI/LiveClawBench
// @ 303dc77, MIT, mock-platform/mocks/workspace), one SQLite file per run.
//
// Generated with `prisma db pull` from upstream's own CREATE TABLE and
// CREATE INDEX statements (each fixture's `_schema`), so each table, column,
// key, foreign key and index is upstream's, by name and in order, and
// upstream's verify.py and its own statements read a run's file as they
// read upstream's. Column types are as SQLite keeps them (text, integer,
// real); a default of SQLite's 'now' is `datetime('now')`, which each run
// answers with its clock. Prisma cannot state upstream's CHECKs: each run
// gets them as triggers (mocks/upstream/checks.ts). The last four models
// are the fake's own (mocks/upstream).
//
// No tenant column: a run is one world, as upstream's mock is one.

datasource db {
  provider = "sqlite"
  url      = env("INTEG_DB_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "client"
}

model brief_entry {
  id               Int    @id @default(autoincrement())
  note_id          Int    @unique
  key_updates      String @default("")
  evidence_bullets String @default("[]")
  action_items     String @default("[]")
  citations        String @default("[]")
  status           String @default("draft")
  created_at       String @default(dbgenerated("(datetime('now'))"))
  updated_at       String @default(dbgenerated("(datetime('now'))"))
  note             note   @relation(fields: [note_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model note {
  id            Int             @id @default(autoincrement())
  owner_user_id Int
  title         String
  content       String          @default("")
  content_type  String          @default("plain_text")
  preview_text  String          @default("")
  is_seeded     Int             @default(0)
  save_count    Int             @default(0)
  created_at    String          @default(dbgenerated("(datetime('now'))"))
  updated_at    String          @default(dbgenerated("(datetime('now'))"))
  brief_entry   brief_entry?
  user          user            @relation(fields: [owner_user_id], references: [id], onUpdate: NoAction)
  note_revision note_revision[]
  task_record   task_record?
}

model note_revision {
  id                Int    @id @default(autoincrement())
  note_id           Int
  revision_no       Int
  content_snapshot  String
  change_summary    String @default("")
  edited_by_user_id Int
  edited_at         String @default(dbgenerated("(datetime('now'))"))
  user              user   @relation(fields: [edited_by_user_id], references: [id], onUpdate: NoAction)
  note              note   @relation(fields: [note_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([note_id, revision_no])
}

model task_record {
  id             Int    @id @default(autoincrement())
  note_id        Int    @unique
  record_type    String @default("summary")
  source_channel String @default("manual")
  summary_text   String @default("")
  status         String @default("open")
  created_at     String @default(dbgenerated("(datetime('now'))"))
  updated_at     String @default(dbgenerated("(datetime('now'))"))
  note           note   @relation(fields: [note_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user {
  id            Int             @id @default(autoincrement())
  username      String          @unique
  password      String
  display_name  String          @default("")
  role          String          @default("user")
  is_active     Int             @default(1)
  created_at    String          @default(dbgenerated("(datetime('now'))"))
  updated_at    String          @default(dbgenerated("(datetime('now'))"))
  note          note[]
  note_revision note_revision[]
}

// The environment upstream's mock reads from its process (`TASK_NAME`),
// which a fake every task of a job shares cannot take from its own: each
// task's fixture states it.
model vfsbench_env {
  name  String @id
  value String

  @@map("_env")
}

// Each file the mock keeps on disk upstream, by its path in the image, and
// the task's assets: text as it is, anything else as base64.
model vfsbench_file {
  path     String @id
  data     String
  encoding String @default("utf8")

  @@map("_file")
}

// The rows of upstream's tables Prisma cannot key (marked @@ignore above),
// which the fake inserts itself, in order, once the kit has seeded the rest.
model vfsbench_row {
  seq   Int    @id
  table String
  data  String

  @@map("_row")
}

// Upstream's CREATE TABLE and CREATE INDEX statements, as its seed ran them.
model vfsbench_schema {
  name String @id
  type String
  sql  String

  @@map("_schema")
}
