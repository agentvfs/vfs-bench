[
 {
  "name": "rss",
  "description": "The rss service's tools.",
  "tools": [
   {
    "name": "list_articles",
    "call": "rss_list_articles",
    "description": "获取RSS文章列表",
    "parameters": {
     "type": "object",
     "properties": {
      "feed_name": {
       "type": "string",
       "description": "按RSS源筛选"
      },
      "category": {
       "type": "string",
       "description": "按分类筛选"
      },
      "max_results": {
       "type": "integer",
       "description": "最大返回数量",
       "default": 20
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9109/rss/articles",
     "method": "POST"
    }
   },
   {
    "name": "get_article",
    "call": "rss_get_article",
    "description": "获取文章详情",
    "parameters": {
     "type": "object",
     "properties": {
      "article_id": {
       "type": "string",
       "description": "文章ID"
      }
     },
     "required": [
      "article_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9109/rss/articles/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "kb",
  "description": "The kb service's tools.",
  "tools": [
   {
    "name": "search",
    "call": "kb_search",
    "description": "搜索知识库文章",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "搜索关键词"
      },
      "category": {
       "type": "string",
       "description": "按分类筛选"
      },
      "max_results": {
       "type": "integer",
       "description": "最大返回数量",
       "default": 5
      }
     },
     "required": [
      "query"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/search",
     "method": "POST"
    }
   },
   {
    "name": "get_article",
    "call": "kb_get_article",
    "description": "获取知识库文章全文",
    "parameters": {
     "type": "object",
     "properties": {
      "article_id": {
       "type": "string",
       "description": "文章ID"
      }
     },
     "required": [
      "article_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/articles/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "gmail",
  "description": "The gmail service's tools.",
  "tools": [
   {
    "name": "save_draft",
    "call": "gmail_save_draft",
    "description": "保存邮件草稿",
    "parameters": {
     "type": "object",
     "properties": {
      "to": {
       "type": "string",
       "description": "收件人"
      },
      "subject": {
       "type": "string",
       "description": "主题"
      },
      "body": {
       "type": "string",
       "description": "正文"
      }
     },
     "required": [
      "to",
      "subject",
      "body"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9100/gmail/drafts/save",
     "method": "POST"
    }
   }
  ]
 }
]
