[
 {
  "name": "gmail",
  "description": "The gmail service's tools.",
  "tools": [
   {
    "name": "save_draft",
    "call": "gmail_save_draft",
    "description": "Save email draft",
    "parameters": {
     "type": "object",
     "properties": {
      "to": {
       "type": "string",
       "description": "Recipient"
      },
      "subject": {
       "type": "string",
       "description": "Subject"
      },
      "body": {
       "type": "string",
       "description": "Body"
      },
      "reply_to_message_id": {
       "type": "string",
       "description": "Original message ID to reply to"
      }
     },
     "required": [
      "to",
      "subject",
      "body"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9100/gmail/drafts/save",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "contacts",
  "description": "The contacts service's tools.",
  "tools": [
   {
    "name": "search",
    "call": "contacts_search",
    "description": "Search internal directory",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "Search keyword"
      },
      "department": {
       "type": "string",
       "description": "Filter by department"
      }
     },
     "required": [
      "query"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9103/contacts/search",
     "method": "POST"
    }
   },
   {
    "name": "get",
    "call": "contacts_get",
    "description": "Get contact details",
    "parameters": {
     "type": "object",
     "properties": {
      "contact_id": {
       "type": "string",
       "description": "Contact ID"
      }
     },
     "required": [
      "contact_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9103/contacts/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "crm",
  "description": "The crm service's tools.",
  "tools": [
   {
    "name": "list_customers",
    "call": "crm_list_customers",
    "description": "List customers",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "Customer status filter"
      },
      "tier": {
       "type": "string",
       "description": "Customer tier filter (vip/standard)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9110/crm/customers",
     "method": "POST"
    }
   },
   {
    "name": "get_customer",
    "call": "crm_get_customer",
    "description": "Get customer details",
    "parameters": {
     "type": "object",
     "properties": {
      "customer_id": {
       "type": "string",
       "description": "Customer ID"
      }
     },
     "required": [
      "customer_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9110/crm/customers/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "helpdesk",
  "description": "The helpdesk service's tools.",
  "tools": [
   {
    "name": "list_tickets",
    "call": "helpdesk_list_tickets",
    "description": "List tickets",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "Ticket status filter (open/all)",
       "default": "open"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets",
     "method": "POST"
    }
   },
   {
    "name": "get_ticket",
    "call": "helpdesk_get_ticket",
    "description": "Get ticket details",
    "parameters": {
     "type": "object",
     "properties": {
      "ticket_id": {
       "type": "string",
       "description": "Ticket ID"
      }
     },
     "required": [
      "ticket_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets/get",
     "method": "POST"
    }
   },
   {
    "name": "update_ticket",
    "call": "helpdesk_update_ticket",
    "description": "Update ticket (priority, tags, category)",
    "parameters": {
     "type": "object",
     "properties": {
      "ticket_id": {
       "type": "string",
       "description": "Ticket ID"
      },
      "priority": {
       "type": "string",
       "description": "Priority"
      },
      "tags": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Tag list"
      },
      "category": {
       "type": "string",
       "description": "Ticket category"
      },
      "assigned_to": {
       "type": "string",
       "description": "Assign to"
      }
     },
     "required": [
      "ticket_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets/update",
     "method": "POST"
    }
   }
  ]
 }
]
