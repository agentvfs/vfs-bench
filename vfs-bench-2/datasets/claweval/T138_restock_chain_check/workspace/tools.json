[
 {
  "name": "scheduler",
  "description": "The scheduler service's tools.",
  "tools": [
   {
    "name": "list_jobs",
    "call": "scheduler_list_jobs",
    "description": "List scheduled jobs",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "Filter by status (all/enabled/disabled)"
      },
      "tag": {
       "type": "string",
       "description": "Filter by tag"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs",
     "method": "POST"
    }
   },
   {
    "name": "get_job",
    "call": "scheduler_get_job",
    "description": "Get scheduled job details",
    "parameters": {
     "type": "object",
     "properties": {
      "job_id": {
       "type": "string",
       "description": "Job ID"
      }
     },
     "required": [
      "job_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs/get",
     "method": "POST"
    }
   }
  ]
 },
