[
 {
  "name": "rss",
  "description": "The rss service's tools.",
  "tools": [
   {
    "name": "list_articles",
    "call": "rss_list_articles",
    "description": "获取RSS文章列表",
    "parameters": {
     "type": "object",
     "properties": {
      "feed_name": {
       "type": "string",
       "description": "按RSS源筛选"
      },
      "category": {
       "type": "string",
       "description": "按分类筛选"
      },
      "max_results": {
       "type": "integer",
       "description": "最大返回数量",
       "default": 20
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9109/rss/articles",
     "method": "POST"
    }
   },
   {
    "name": "get_article",
    "call": "rss_get_article",
    "description": "获取文章详情",
    "parameters": {
     "type": "object",
     "properties": {
      "article_id": {
       "type": "string",
       "description": "文章ID"
      }
     },
     "required": [
      "article_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9109/rss/articles/get",
     "method": "POST"
    }
   }
  ]
 },
