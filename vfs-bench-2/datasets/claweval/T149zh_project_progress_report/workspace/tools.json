[
 {
  "name": "notes",
  "description": "The notes service's tools.",
  "tools": [
   {
    "name": "list",
    "call": "notes_list",
    "description": "列出会议纪要",
    "parameters": {
     "type": "object",
     "properties": {
      "tag": {
       "type": "string",
       "description": "按标签筛选"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9105/notes/list",
     "method": "POST"
    }
   },
   {
    "name": "get",
    "call": "notes_get",
    "description": "获取纪要详情",
    "parameters": {
     "type": "object",
     "properties": {
      "note_id": {
       "type": "string",
       "description": "纪要ID"
      }
     },
     "required": [
      "note_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9105/notes/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "todo",
  "description": "The todo service's tools.",
  "tools": [
   {
    "name": "list_tasks",
    "call": "todo_list_tasks",
    "description": "查看待办事项列表",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "状态筛选(pending/completed/all)",
       "default": "all"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9102/todo/tasks",
     "method": "POST"
    }
   },
   {
    "name": "get_task",
    "call": "todo_get_task",
    "description": "获取待办详情",
    "parameters": {
     "type": "object",
     "properties": {
      "task_id": {
       "type": "string",
       "description": "待办ID"
      }
     },
     "required": [
      "task_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9102/todo/tasks/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "contacts",
  "description": "The contacts service's tools.",
  "tools": [
   {
    "name": "search",
    "call": "contacts_search",
    "description": "搜索内部通讯录",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "搜索关键词"
      },
      "department": {
       "type": "string",
       "description": "按部门筛选"
      }
     },
     "required": [
      "query"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9103/contacts/search",
     "method": "POST"
    }
   },
   {
    "name": "get",
    "call": "contacts_get",
    "description": "获取联系人详情",
    "parameters": {
     "type": "object",
     "properties": {
      "contact_id": {
       "type": "string",
       "description": "联系人ID"
      }
     },
     "required": [
      "contact_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9103/contacts/get",
     "method": "POST"
    }
   }
  ]
 }
]
