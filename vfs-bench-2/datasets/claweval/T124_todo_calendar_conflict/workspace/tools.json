[
 {
  "name": "todo",
  "description": "The todo service's tools.",
  "tools": [
   {
    "name": "list_tasks",
    "call": "todo_list_tasks",
    "description": "View to-do list",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "Filter by status (pending/completed/all)",
       "default": "pending"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9102/todo/tasks",
     "method": "POST"
    }
   },
   {
    "name": "get_task",
    "call": "todo_get_task",
    "description": "Get to-do item details",
    "parameters": {
     "type": "object",
     "properties": {
      "task_id": {
       "type": "string",
       "description": "Task ID"
      }
     },
     "required": [
      "task_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9102/todo/tasks/get",
     "method": "POST"
    }
   }
  ]
 }
]
