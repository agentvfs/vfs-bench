[
 {
  "name": "helpdesk",
  "description": "The helpdesk service's tools.",
  "tools": [
   {
    "name": "list_tickets",
    "call": "helpdesk_list_tickets",
    "description": "列出工单",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "工单状态筛选(open/all)",
       "default": "open"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets",
     "method": "POST"
    }
   },
   {
    "name": "get_ticket",
    "call": "helpdesk_get_ticket",
    "description": "获取工单详情",
    "parameters": {
     "type": "object",
     "properties": {
      "ticket_id": {
       "type": "string",
       "description": "工单ID"
      }
     },
     "required": [
      "ticket_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets/get",
     "method": "POST"
    }
   },
   {
    "name": "close_ticket",
    "call": "helpdesk_close_ticket",
    "description": "关闭工单",
    "parameters": {
     "type": "object",
     "properties": {
      "ticket_id": {
       "type": "string",
       "description": "工单ID"
      },
      "resolution": {
       "type": "string",
       "description": "解决说明"
      }
     },
     "required": [
      "ticket_id",
      "resolution"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets/close",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "kb",
  "description": "The kb service's tools.",
  "tools": [
   {
    "name": "search",
    "call": "kb_search",
    "description": "搜索知识库文章",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "搜索关键词"
      },
      "category": {
       "type": "string",
       "description": "按分类筛选"
      },
      "max_results": {
       "type": "integer",
       "description": "最大返回数量",
       "default": 5
      }
     },
     "required": [
      "query"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/search",
     "method": "POST"
    }
   },
   {
    "name": "get_article",
    "call": "kb_get_article",
    "description": "获取知识库文章全文",
    "parameters": {
     "type": "object",
     "properties": {
      "article_id": {
       "type": "string",
       "description": "文章ID"
      }
     },
     "required": [
      "article_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/articles/get",
     "method": "POST"
    }
   }
  ]
 }
]
