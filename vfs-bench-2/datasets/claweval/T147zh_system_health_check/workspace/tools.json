[
 {
  "name": "helpdesk",
  "description": "The helpdesk service's tools.",
  "tools": [
   {
    "name": "list_tickets",
    "call": "helpdesk_list_tickets",
    "description": "列出工单",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "工单状态筛选(open/all)",
       "default": "open"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets",
     "method": "POST"
    }
   },
   {
    "name": "get_ticket",
    "call": "helpdesk_get_ticket",
    "description": "获取工单详情",
    "parameters": {
     "type": "object",
     "properties": {
      "ticket_id": {
       "type": "string",
       "description": "工单ID"
      }
     },
     "required": [
      "ticket_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets/get",
     "method": "POST"
    }
   },
   {
    "name": "update_ticket",
    "call": "helpdesk_update_ticket",
    "description": "更新工单",
    "parameters": {
     "type": "object",
     "properties": {
      "ticket_id": {
       "type": "string",
       "description": "工单ID"
      },
      "priority": {
       "type": "string",
       "description": "优先级"
      },
      "tags": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "标签列表"
      }
     },
     "required": [
      "ticket_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets/update",
     "method": "POST"
    }
   },
   {
    "name": "close_ticket",
    "call": "helpdesk_close_ticket",
    "description": "关闭工单",
    "parameters": {
     "type": "object",
     "properties": {
      "ticket_id": {
       "type": "string",
       "description": "工单ID"
      },
      "resolution": {
       "type": "string",
       "description": "解决说明"
      }
     },
     "required": [
      "ticket_id",
      "resolution"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9107/helpdesk/tickets/close",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "scheduler",
  "description": "The scheduler service's tools.",
  "tools": [
   {
    "name": "list_jobs",
    "call": "scheduler_list_jobs",
    "description": "列出定时任务",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "按状态筛选(all/enabled/disabled)"
      },
      "tag": {
       "type": "string",
       "description": "按标签筛选"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs",
     "method": "POST"
    }
   },
   {
    "name": "get_job",
    "call": "scheduler_get_job",
    "description": "获取定时任务详情",
    "parameters": {
     "type": "object",
     "properties": {
      "job_id": {
       "type": "string",
       "description": "任务ID"
      }
     },
     "required": [
      "job_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "config",
  "description": "The config service's tools.",
  "tools": [
   {
    "name": "list_integrations",
    "call": "config_list_integrations",
    "description": "列出系统集成配置",
    "parameters": {
     "type": "object",
     "properties": {
      "type": {
       "type": "string",
       "description": "按类型筛选"
      },
      "status": {
       "type": "string",
       "description": "按状态筛选"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9111/config/integrations",
     "method": "POST"
    }
   },
   {
    "name": "get_integration",
    "call": "config_get_integration",
    "description": "获取集成配置详情",
    "parameters": {
     "type": "object",
     "properties": {
      "integration_id": {
       "type": "string",
       "description": "集成ID"
      }
     },
     "required": [
      "integration_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9111/config/integrations/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "kb",
  "description": "The kb service's tools.",
  "tools": [
   {
    "name": "search",
    "call": "kb_search",
    "description": "搜索知识库文章",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "搜索关键词"
      },
      "category": {
       "type": "string",
       "description": "按分类筛选"
      },
      "max_results": {
       "type": "integer",
       "description": "最大返回数量",
       "default": 5
      }
     },
     "required": [
      "query"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/search",
     "method": "POST"
    }
   },
   {
    "name": "get_article",
    "call": "kb_get_article",
    "description": "获取知识库文章全文",
    "parameters": {
     "type": "object",
     "properties": {
      "article_id": {
       "type": "string",
       "description": "文章ID"
      }
     },
     "required": [
      "article_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/articles/get",
     "method": "POST"
    }
   }
  ]
 }
]
