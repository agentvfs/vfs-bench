[
 {
  "name": "crm",
  "description": "The crm service's tools.",
  "tools": [
   {
    "name": "list_customers",
    "call": "crm_list_customers",
    "description": "列出客户",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "客户状态(active/churned)"
      },
      "tier": {
       "type": "string",
       "description": "客户等级(vip/standard)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9110/crm/customers",
     "method": "POST"
    }
   },
   {
    "name": "get_customer",
    "call": "crm_get_customer",
    "description": "获取客户详情",
    "parameters": {
     "type": "object",
     "properties": {
      "customer_id": {
       "type": "string",
       "description": "客户ID"
      }
     },
     "required": [
      "customer_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9110/crm/customers/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "inventory",
  "description": "The inventory service's tools.",
  "tools": [
   {
    "name": "list_items",
    "call": "inventory_list_items",
    "description": "查看库存/产品列表",
    "parameters": {
     "type": "object",
     "properties": {
      "category": {
       "type": "string",
       "description": "按分类筛选"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9108/inventory/products",
     "method": "POST"
    }
   },
   {
    "name": "get_item",
    "call": "inventory_get_item",
    "description": "获取产品详情",
    "parameters": {
     "type": "object",
     "properties": {
      "product_id": {
       "type": "string",
       "description": "产品ID"
      }
     },
     "required": [
      "product_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9108/inventory/products/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "finance",
  "description": "The finance service's tools.",
  "tools": [
   {
    "name": "list_transactions",
    "call": "finance_list_transactions",
    "description": "查看交易记录",
    "parameters": {
     "type": "object",
     "properties": {
      "start_date": {
       "type": "string",
       "description": "起始日期(YYYY-MM-DD)"
      },
      "end_date": {
       "type": "string",
       "description": "截止日期(YYYY-MM-DD)"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9104/finance/transactions",
     "method": "POST"
    }
   },
   {
    "name": "get_transaction",
    "call": "finance_get_transaction",
    "description": "获取交易详情",
    "parameters": {
     "type": "object",
     "properties": {
      "transaction_id": {
       "type": "string",
       "description": "交易ID"
      }
     },
     "required": [
      "transaction_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9104/finance/transactions/get",
     "method": "POST"
    }
   }
  ]
 }
]
