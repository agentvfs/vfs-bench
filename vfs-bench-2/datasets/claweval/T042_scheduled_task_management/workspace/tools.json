[
 {
  "name": "scheduler",
  "description": "The scheduler service's tools.",
  "tools": [
   {
    "name": "list_jobs",
    "call": "scheduler_list_jobs",
    "description": "List all scheduled jobs",
    "parameters": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "description": "Filter by last run status (success/failed)"
      },
      "enabled": {
       "type": "boolean",
       "description": "Filter by enabled status"
      },
      "tag": {
       "type": "string",
       "description": "Filter by tag"
      }
     },
     "required": []
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs",
     "method": "POST"
    }
   },
   {
    "name": "get_job",
    "call": "scheduler_get_job",
    "description": "Get scheduled job details",
    "parameters": {
     "type": "object",
     "properties": {
      "job_id": {
       "type": "string",
       "description": "Job ID"
      }
     },
     "required": [
      "job_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs/get",
     "method": "POST"
    }
   },
   {
    "name": "create_job",
    "call": "scheduler_create_job",
    "description": "Create a new scheduled job",
    "parameters": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string",
       "description": "Job name"
      },
      "cron_expression": {
       "type": "string",
       "description": "Cron expression"
      },
      "action": {
       "type": "string",
       "description": "Job action to execute"
      },
      "enabled": {
       "type": "boolean",
       "description": "Whether to enable the job",
       "default": true
      },
      "tags": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Tag list"
      }
     },
     "required": [
      "name",
      "cron_expression",
      "action"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs/create",
     "method": "POST"
    }
   },
   {
    "name": "update_job",
    "call": "scheduler_update_job",
    "description": "Update scheduled job configuration",
    "parameters": {
     "type": "object",
     "properties": {
      "job_id": {
       "type": "string",
       "description": "Job ID"
      },
      "enabled": {
       "type": "boolean",
       "description": "Whether to enable"
      },
      "cron_expression": {
       "type": "string",
       "description": "New cron expression"
      },
      "name": {
       "type": "string",
       "description": "New name"
      },
      "action": {
       "type": "string",
       "description": "New action"
      },
      "tags": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "New tags"
      }
     },
     "required": [
      "job_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs/update",
     "method": "POST"
    }
   },
   {
    "name": "delete_job",
    "call": "scheduler_delete_job",
    "description": "Delete a scheduled job",
    "parameters": {
     "type": "object",
     "properties": {
      "job_id": {
       "type": "string",
       "description": "Job ID"
      }
     },
     "required": [
      "job_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs/delete",
     "method": "POST"
    }
   },
   {
    "name": "job_history",
    "call": "scheduler_job_history",
    "description": "View scheduled job execution history",
    "parameters": {
     "type": "object",
     "properties": {
      "job_id": {
       "type": "string",
       "description": "Job ID"
      },
      "limit": {
       "type": "integer",
       "description": "Number of entries to return",
       "default": 10
      }
     },
     "required": [
      "job_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9112/scheduler/jobs/history",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "kb",
  "description": "The kb service's tools.",
  "tools": [
   {
    "name": "search",
    "call": "kb_search",
    "description": "Search knowledge base articles",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "Search keywords"
      },
      "category": {
       "type": "string",
       "description": "Filter by category"
      },
      "max_results": {
       "type": "integer",
       "description": "Maximum results",
       "default": 5
      }
     },
     "required": [
      "query"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/search",
     "method": "POST"
    }
   },
   {
    "name": "get_article",
    "call": "kb_get_article",
    "description": "Get knowledge base article details",
    "parameters": {
     "type": "object",
     "properties": {
      "article_id": {
       "type": "string",
       "description": "Article ID"
      }
     },
     "required": [
      "article_id"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9106/kb/articles/get",
     "method": "POST"
    }
   }
  ]
 },
 {
  "name": "gmail",
  "description": "The gmail service's tools.",
  "tools": [
   {
    "name": "save_draft",
    "call": "gmail_save_draft",
    "description": "Save email as draft",
    "parameters": {
     "type": "object",
     "properties": {
      "to": {
       "type": "string",
       "description": "Recipient email"
      },
      "subject": {
       "type": "string",
       "description": "Email subject"
      },
      "body": {
       "type": "string",
       "description": "Email body"
      }
     },
     "required": [
      "to",
      "subject",
      "body"
     ]
    },
    "endpoint": {
     "url": "http://localhost:9100/gmail/drafts/save",
     "method": "POST"
    }
   }
  ]
 }
]
